# Copy to .env (docker compose reads it automatically). Every value is optional.

# Shared secret between the Laravel API and the Go content service.
CONTENT_SERVICE_KEY=change-me

# Midtrans SANDBOX server key (https://dashboard.sandbox.midtrans.com -> Settings -> Access Keys).
# Leave empty to run without the payment gateway: orders are created without a Snap token,
# and you can use the local-only simulate-paid endpoint instead.
MIDTRANS_SERVER_KEY=
